{
  "name": "@hummingbirdui/react",
  "version": "1.0.0-insider.10",
  "description": "Modern, accessible, and customizable React components built with Radix UI and Tailwind CSS.",
  "keywords": [
    "hummingbird",
    "react",
    "tailwindcss",
    "components",
    "modern-components",
    "react-components",
    "radix-ui",
    "react-ui"
  ],
  "homepage": "https://react.hbui.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/hummingbirdui/hummingbird-react.git"
  },
  "license": "MIT",
  "author": "Hummingbird UI",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/styles.css",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*/index.d.ts",
      "import": "./dist/hooks/*/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./layout/*": {
      "types": "./dist/layout/*/index.d.ts",
      "import": "./dist/layout/*/index.js"
    },
    "./typography": {
      "types": "./dist/typography/index.d.ts",
      "import": "./dist/typography/index.js"
    },
    "./typography/*": {
      "types": "./dist/typography/*/index.d.ts",
      "import": "./dist/typography/*/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c && tsup && tsc -p tsconfig.build.json && node scripts/resolve-import-paths.mjs",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "prepublishOnly": "node -e \"require('fs').accessSync('dist/index.js');require('fs').accessSync('dist/styles.css')\""
  },
  "dependencies": {
    "@hummingbirdui/hummingbird": "^1.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.0",
    "react-day-picker": "^10.0.1",
    "react-dropzone": "^20.1.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^1.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.33.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
