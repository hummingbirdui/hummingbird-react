type":"text","url":"/docs/customize/dark-mode#key-idea","content":"`--color-primary`"},"181":{"id":"/docs/customize/dark-mode-19","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#key-idea","content":"`--border-color-default`"},"182":{"id":"/docs/customize/dark-mode-20","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#result","content":"Switching themes requires no component changes — only variable values update. Every Hummingbird React component adapts automatically."},"183":{"id":"/docs/customize/dark-mode-21","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#customizing-dark-mode","content":"Override variables after importing Hummingbird:"},"184":{"id":"/docs/customize/dark-mode-22","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#1-custom-dark-mode-selector","content":"Enable class-based dark mode after importing Tailwind and Hummingbird styles:"},"185":{"id":"/docs/customize/dark-mode-23","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#2-set-the-initial-theme","content":"Render `ThemeModeScript` inside `<head>` to apply the saved theme before first paint - no flash of the wrong theme. Safe in React Server Components."},"186":{"id":"/docs/customize/dark-mode-24","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#3-add-a-theme-toggle","content":"`DarkThemeToggle` switches between light and dark mode, persists the choice, and keeps all tabs in sync."},"187":{"id":"/docs/customize/dark-mode-25","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#3-add-a-theme-toggle","content":"Pass your own icons to replace the default sun/moon:"},"188":{"id":"/docs/customize/dark-mode-26","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#3-add-a-theme-toggle","content":"It is built on Button, so all `Button` props work too."},"189":{"id":"/docs/customize/dark-mode-27","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#the-usethememode-hook","content":"For custom controls, use `useThemeMode`. It applies the `.dark` class, follows the OS preference in `\"system\"` mode, and stays in sync across components and browser tabs. `DarkThemeToggle` uses it internally."},"190":{"id":"/docs/customize/dark-mode-28","page_id":"/docs/customize/dark-mode","tags":[],"type":"text","url":"/docs/customize/dark-mode#dark-mode-variable-overrides","content":"A list of theme variables that are overridden when dark mode is active."},"191":{"id":"/docs/customize/reboot","page_id":"/docs/customize/reboot","type":"page","content":"Reboot","breadcrumbs":["Docs","Customize"],"tags":[],"url":"/docs/customize/reboot"},"192":{"id":"/docs/customize/reboot-0","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot","content":"Reboot is a file that includes a set of CSS with element-specific changes that gives Hummingbird a clean, consistent starting point for building websites."},"193":{"id":"/docs/customize/reboot-1","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#css-variables","content":"CSS variables"},"194":{"id":"/docs/customize/reboot-2","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#headings","content":"Headings"},"195":{"id":"/docs/customize/reboot-3","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#paragraph","content":"Paragraph"},"196":{"id":"/docs/customize/reboot-4","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#links","content":"Links"},"197":{"id":"/docs/customize/reboot-5","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#buttons","content":"Buttons"},"198":{"id":"/docs/customize/reboot-6","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#horizontal-rules","content":"Horizontal rules"},"199":{"id":"/docs/customize/reboot-7","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#lists","content":"Lists"},"200":{"id":"/docs/customize/reboot-8","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#description-lists","content":"Description lists"},"201":{"id":"/docs/customize/reboot-9","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#code","content":"Code"},"202":{"id":"/docs/customize/reboot-10","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#address","content":"Address"},"203":{"id":"/docs/customize/reboot-11","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#blockquote","content":"Blockquote"},"204":{"id":"/docs/customize/reboot-12","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#legend","content":"Legend"},"205":{"id":"/docs/customize/reboot-13","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#captions","content":"Captions"},"206":{"id":"/docs/customize/reboot-14","page_id":"/docs/customize/reboot","type":"heading","tags":[],"url":"/docs/customize/reboot#reboot-css-variables","content":"Reboot CSS variables"},"207":{"id":"/docs/customize/reboot-15","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#css-variables","content":"CSS variables provide a powerful way to customize and theme projects. It is a feature in modern CSS that allows defining reusable values directly in stylesheets. CSS variables make customization easy: change a value in one place (like `:root`) and it updates everywhere the variable is used. Variables can be set at different levels (global, component, etc.), making them flexible."},"208":{"id":"/docs/customize/reboot-16","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#css-variables","content":"A \"Reboot\" stylesheet (like Hummingbird's Reboot) resets browser styles and sets up a foundation for consistent design. Using CSS variables in Reboot makes it easy to customize base styles without editing the core CSS — just override the variables."},"209":{"id":"/docs/customize/reboot-17","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#css-variables","content":"Tailwind CSS uses CSS variables for theming and customization. Hummingbird makes use of Tailwind's CSS variable feature to define colors, typography, spacing, and more. This allows projects to easily adapt the design system to specific needs. Learn more about Hummingbird's CSS variables in the Theming section."},"210":{"id":"/docs/customize/reboot-18","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#css-variables","content":"Reboot is included automatically when Hummingbird CSS is imported, so JSX elements rendered by React components get these base styles with no extra setup."},"211":{"id":"/docs/customize/reboot-19","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#headings","content":"All the headings (`h1` to `h6`) in Hummingbird are styled with CSS variables for font size, weight, line height, and margin."},"212":{"id":"/docs/customize/reboot-20","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#paragraph","content":"For all paragraph (`<p>`) elements, `margin-top` was removed, and `margin-bottom: 1rem` is set."},"213":{"id":"/docs/customize/reboot-21","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#links","content":"Links are styled with a default `color` and an `underline`. On hover, the link color changes to a darker shade."},"214":{"id":"/docs/customize/reboot-22","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#buttons","content":"By default, buttons (`<button>`) have a `cursor-pointer` style. When a button is disabled, the cursor changes to `cursor-default`."},"215":{"id":"/docs/customize/reboot-23","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#horizontal-rules","content":"Default `margin-top` and `margin-bottom` for horizontal rules (`<hr>`) is set to `1rem`."},"216":{"id":"/docs/customize/reboot-24","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#lists","content":"By default, unordered lists (`<ul>`) use disc bullets, and ordered lists (`<ol>`) use decimal numbers. Both types of lists have a left padding of `2rem` and a bottom margin of `1rem`. Nested lists have no bottom margin."},"217":{"id":"/docs/customize/reboot-25","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#description-lists","content":"Terms (`<dt>`) are styled with a bold font weight, while descriptions (`<dd>`) use a regular font weight. Default `margin-bottom` for `<dl>` is `1rem`."},"218":{"id":"/docs/customize/reboot-26","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#code","content":"By default, inline code elements (`<code>`) are styled with a specific text color and font size. When a `<code>` element is nested inside an `<a>` tag, it inherits the link's text color and font size."},"219":{"id":"/docs/customize/reboot-27","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#address","content":"The `<address>` element is styled with a bottom margin of `1rem`."},"220":{"id":"/docs/customize/reboot-28","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#blockquote","content":"By default, blockquotes (`<blockquote>`) have a bottom margin of `1rem`."},"221":{"id":"/docs/customize/reboot-29","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#legend","content":"The `<legend>` element is styled to be a block-level element with full width, no padding, and specific margin, font weight, and font size."},"222":{"id":"/docs/customize/reboot-30","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#captions","content":"By default, table captions (`<caption>`) are aligned to the left and positioned at the bottom of the table. They also have specific font weight and padding."},"223":{"id":"/docs/customize/reboot-31","page_id":"/docs/customize/reboot","tags":[],"type":"text","url":"/docs/customize/reboot#reboot-css-variables","content":"The following CSS variables are defined in Hummingbird for reboot styles. Override these variables in the CSS to customize the base styles of the project."},"224":{"id":"/docs/customize/theming","page_id":"/docs/customize/theming","type":"page","content":"Theming","breadcrumbs":["Docs","Customize"],"tags":[],"url":"/docs/customize/theming"},"225":{"id":"/docs/customize/theming-0","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming","content":"Learn how to customize Hummingbird React with Tailwind CSS v4 theme variables, override tokens, and support multiple themes and dark mode."},"226":{"id":"/docs/customize/theming-1","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#overview","content":"Overview"},"227":{"id":"/docs/customize/theming-2","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#available-themes","content":"Available themes"},"228":{"id":"/docs/customize/theming-3","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#how-to-use-themes","content":"How to use themes"},"229":{"id":"/docs/customize/theming-4","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#customizing-theme","content":"Customizing theme"},"230":{"id":"/docs/customize/theming-5","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#spacing","content":"Spacing"},"231":{"id":"/docs/customize/theming-6","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#breakpoints","content":"Breakpoints"},"232":{"id":"/docs/customize/theming-7","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#list-of-theme-variables","content":"List of theme variables"},"233":{"id":"/docs/customize/theming-8","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#how-to-use-multiple-themes-at-once","content":"How to use multiple themes at once"},"234":{"id":"/docs/customize/theming-9","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#reboot","content":"Reboot"},"235":{"id":"/docs/customize/theming-10","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#tailwinds-helper-functions","content":"Tailwind's helper functions"},"236":{"id":"/docs/customize/theming-11","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#--spacing","content":"`--spacing()`"},"237":{"id":"/docs/customize/theming-12","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#--alpha","content":"`--alpha()`"},"238":{"id":"/docs/customize/theming-13","page_id":"/docs/customize/theming","type":"heading","tags":[],"url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Tailwind theme variable namespaces"},"239":{"id":"/docs/customize/theming-14","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#overview","content":"Hummingbird React is styled by Hummingbird CSS, which is built on Tailwind CSS v4 and provides a comprehensive set of theme variables (design tokens) for colors, typography, shadows, and more. Because theming happens entirely in CSS, no React code changes are needed to restyle the components."},"240":{"id":"/docs/customize/theming-15","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#overview","content":"Offers multiple prebuilt themes like luxury, retro, arctic etc. These themes are highly customizable, allowing individual tokens to be tweaked or entirely new color palettes to be created to match specific brand aesthetics."},"241":{"id":"/docs/customize/theming-16","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#overview","content":"Use the theme variables (like `--color-primary` and `--shadow-md`) via standard Tailwind utilities (for example, `bg-primary`, `text-primary`, `shadow-md`)."},"242":{"id":"/docs/customize/theming-17","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#overview","content":"Override any theme variables globally by redefining them in an `@theme { ... }` block after importing the CSS."},"243":{"id":"/docs/customize/theming-18","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#overview","content":"Reboot provides a base CSS reset with element-specific styles for consistent design across browsers."},"244":{"id":"/docs/customize/theming-19","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"Here is a quick overview of the available prebuilt themes:"},"245":{"id":"/docs/customize/theming-20","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"The signature Hummingbird theme with balanced neutrals and vibrant blue\naccents."},"246":{"id":"/docs/customize/theming-21","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"Rich maroon and golden tones crafted for a refined, premium appearance."},"247":{"id":"/docs/customize/theming-22","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"Warm vintage-inspired colors that bring a classic and timeless feel."},"248":{"id":"/docs/customize/theming-23","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"Cool blues and frosty tones inspired by modern winter landscapes."},"249":{"id":"/docs/customize/theming-24","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"Fresh greens and earthy shades inspired by the natural world."},"250":{"id":"/docs/customize/theming-25","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"Deep purples and vivid pinks designed for bold, high-contrast\ninterfaces."},"251":{"id":"/docs/customize/theming-26","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"Warm oranges and amber tones that create an energetic, glowing\naesthetic."},"252":{"id":"/docs/customize/theming-27","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#available-themes","content":"Deep blues and indigos designed for calm, modern dark experiences."},"253":{"id":"/docs/customize/theming-28","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#how-to-use-themes","content":"By default, Hummingbird includes the `default` theme. To use a different prebuilt theme, simply import the corresponding CSS file in the main CSS file (e.g., `globals.css`). Each theme has built-in dark mode support, so dark mode will automatically work when the theme is imported."},"254":{"id":"/docs/customize/theming-29","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#how-to-use-themes","content":"Only one theme should be imported at a time, as importing multiple themes will cause the last one to override the others."},"255":{"id":"/docs/customize/theming-30","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#customizing-theme","content":"Redefine theme variables by declaring them in `@theme` after importing Hummingbird:"},"256":{"id":"/docs/customize/theming-31","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#spacing","content":"Customize spacing by overriding the default spacing variable or defining new ones as needed."},"257":{"id":"/docs/customize/theming-32","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#breakpoints","content":"Customize and add new responsive breakpoints by overriding `--breakpoint-*` variables:"},"258":{"id":"/docs/customize/theming-33","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#list-of-theme-variables","content":"Hummingbird provides a small, consistent set of semantic theme variables. These variables create utilities and can be overridden later to change the look and feel without changing any component code. See dark mode variable overrides here."},"259":{"id":"/docs/customize/theming-34","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#how-to-use-multiple-themes-at-once","content":"Hummingbird uses a small set of theme variables. By overriding these variables within a new theme scope, multiple themes can be created."},"260":{"id":"/docs/customize/theming-35","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#how-to-use-multiple-themes-at-once","content":"Create a custom variant for the new themes."},"261":{"id":"/docs/customize/theming-36","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#how-to-use-multiple-themes-at-once","content":"Define the theme variables within the new variant scope. To use an existing theme's colors, simply copy all the variables from the corresponding Hummingbird theme file and paste them into the new variant scope."},"262":{"id":"/docs/customize/theming-37","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#reboot","content":"Reboot is a foundational stylesheet that resets browser defaults and applies basic element styles. It provides a clean, consistent starting point for building interfaces and ensures visual consistency across browsers."},"263":{"id":"/docs/customize/theming-38","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#reboot","content":"For more details, follow the Reboot documentation."},"264":{"id":"/docs/customize/theming-39","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwinds-helper-functions","content":"Tailwind provides the following build-time functions to make working with colors and the spacing scale easier."},"265":{"id":"/docs/customize/theming-40","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#--spacing","content":"Use this function to generate a spacing value based on the theme:"},"266":{"id":"/docs/customize/theming-41","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#--alpha","content":"Use this function to adjust the opacity of a color:"},"267":{"id":"/docs/customize/theming-42","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Tailwind theme variables are defined in namespaces, and each namespace corresponds to one or more utility classes or variant APIs."},"268":{"id":"/docs/customize/theming-43","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Defining new theme variables in these namespaces will make new corresponding utilities and variants available in the project:"},"269":{"id":"/docs/customize/theming-44","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Color utilities like `bg-primary-light`, `text-primary-dark`, and many\nmore"},"270":{"id":"/docs/customize/theming-45","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Text color utilities like `text-default`, `text-subtle`, and many more"},"271":{"id":"/docs/customize/theming-46","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Background color utilities like `bg-highlight`, `bg-emphasis`, and many\nmore"},"272":{"id":"/docs/customize/theming-47","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Border color utilities like `border-default`, `border-subtle`, and many\nmore"},"273":{"id":"/docs/customize/theming-48","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Container query variants like `@sm:*` and size utilities like `max-w-md`"},"274":{"id":"/docs/customize/theming-49","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Spacing and sizing utilities like `px-4`, `max-h-16`, and many more"},"275":{"id":"/docs/customize/theming-50","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Drop shadow filter utilities like `drop-shadow-md`"},"276":{"id":"/docs/customize/theming-51","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Transition timing function utilities like `ease-out`"},"277":{"id":"/docs/customize/theming-52","page_id":"/docs/customize/theming","tags":[],"type":"text","url":"/docs/customize/theming#tailwind-theme-variable-namespaces","content":"Follow the official Tailwind CSS docs for more details."},"278":{"id":"/docs/customize/utilities","page_id":"/docs/customize/utilities","type":"page","content":"Utilities","breadcrumbs":["Docs","Customize"],"tags":[],"url":"/docs/customize/utilities"},"279":{"id":"/docs/customize/utilities-0","page_id":"/docs/customize/utilities","tags":[],"type":"text","url":"/docs/customize/utilities","content":"Frequently used utilities for customizing Hummingbird React components."},"280":{"id":"/docs/customize/utilities-1","page_id":"/docs/customize/utilities","type":"heading","tags":[],"url":"/docs/customize/utilities#padding","content":"Padding"},"281":{"id":"/docs/customize/utilities-2","page_id":"/docs/customize/utilities","type":"heading","tags":[],"url":"/docs/customize/utilities#margin","content":"Margin"},"282":{"id":"/docs/customize/utilities-3","page_id":"/docs/customize/utilities","type":"heading","tags":[],"url":"/docs/customize/utilities#font-family","content":"Font family"},"283":{"id":"/docs/customize/utilities-4","page_id":"/docs/customize/utilities","type":"heading","tags":[],"url":"/docs/customize/utilities#font-size","content":"Font size"},"284":{"id":"/docs/customize/utilities-5","page_id":"/docs/customize/utilities","type":"heading","tags":[],"url":"/docs/customize/utilities#font-weight","content":"Font weight"},"285":{"id":"/docs/customize/utilities-6","page_id":"/docs/customize/utilities","type":"heading","tags":[],"url":"/docs/customize/utilities#line-heig