mbs":["Docs","Getting Started"],"tags":[],"url":"/docs/getting-started/installation"},"1524":{"id":"/docs/getting-started/installation-0","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"Install Hummingbird React and set it up in your project."},"1525":{"id":"/docs/getting-started/installation-1","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#installation","content":"Installation"},"1526":{"id":"/docs/getting-started/installation-2","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#1-install-tailwind-css","content":"1. Install Tailwind CSS"},"1527":{"id":"/docs/getting-started/installation-3","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#2-install-hummingbird-react","content":"2. Install Hummingbird React"},"1528":{"id":"/docs/getting-started/installation-4","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#3-import-css","content":"3. Import CSS"},"1529":{"id":"/docs/getting-started/installation-5","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#4-use-components","content":"4. Use components"},"1530":{"id":"/docs/getting-started/installation-6","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#typescript-support","content":"TypeScript support"},"1531":{"id":"/docs/getting-started/installation-7","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#customization","content":"Customization"},"1532":{"id":"/docs/getting-started/installation-8","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#installation","content":"Using a framework? The framework guides cover Next.js, Vite, Astro, React Router, and Gatsby step by step, including dark mode setup."},"1533":{"id":"/docs/getting-started/installation-9","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#1-install-tailwind-css","content":"Ensure the project is set up with Tailwind CSS. If Tailwind CSS hasn't been set up yet, follow the official installation guide."},"1534":{"id":"/docs/getting-started/installation-10","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#2-install-hummingbird-react","content":"Install Hummingbird React via a preferred package manager."},"1535":{"id":"/docs/getting-started/installation-11","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#3-import-css","content":"Import Hummingbird styles in the main CSS file (e.g., `globals.css`)."},"1536":{"id":"/docs/getting-started/installation-12","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#4-use-components","content":"Import any component and use it in the application."},"1537":{"id":"/docs/getting-started/installation-13","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#typescript-support","content":"Hummingbird React is written in TypeScript and includes type definitions for all components. Component props are fully typed and available on each component's namespace, so no additional `@types` packages are needed."},"1538":{"id":"/docs/getting-started/installation-14","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#customization","content":"All components accept a `className` prop. Custom classes are merged with the component classes, so Tailwind utility classes can be used to adjust any component."},"1539":{"id":"/docs/getting-started/installation-15","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#customization","content":"For theme-level changes such as colors and spacing, Hummingbird provides global and component-specific CSS variables. See the Customize section for details."},"1540":{"id":"/docs/getting-started/introduction","page_id":"/docs/getting-started/introduction","type":"page","content":"Introduction","breadcrumbs":["Docs","Getting Started"],"tags":[],"url":"/docs/getting-started/introduction"},"1541":{"id":"/docs/getting-started/introduction-0","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction","content":"Welcome to the Hummingbird React documentation. It is an open-source React component library built on Hummingbird CSS and Radix UI primitives."},"1542":{"id":"/docs/getting-started/introduction-1","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#what-is-hummingbird-react","content":"What is Hummingbird React?"},"1543":{"id":"/docs/getting-started/introduction-2","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Why Hummingbird React?"},"1544":{"id":"/docs/getting-started/introduction-3","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#pre-requisite-knowledge","content":"Pre-requisite knowledge"},"1545":{"id":"/docs/getting-started/introduction-4","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#join-our-community","content":"Join our community"},"1546":{"id":"/docs/getting-started/introduction-5","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#what-is-hummingbird-react","content":"Hummingbird React is the official React component library for the Hummingbird design system. It provides a large set of accessible, fully styled React components such as buttons, forms, dialogs, and dropdowns, along with patterns suitable for dashboards, SaaS applications, and e-commerce systems."},"1547":{"id":"/docs/getting-started/introduction-6","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#what-is-hummingbird-react","content":"The library follows one core principle: **Hummingbird CSS owns the visuals, and Radix UI owns the behavior**. Every component is styled with Hummingbird's component classes on top of Tailwind CSS, while interactive components use Radix UI primitives for keyboard navigation, focus management, and accessibility. Hummingbird React is the bridge between the two."},"1548":{"id":"/docs/getting-started/introduction-7","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Provides ready-to-use React components with a consistent, typed API."},"1549":{"id":"/docs/getting-started/introduction-8","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Ships accessible behavior out of the box through Radix UI primitives."},"1550":{"id":"/docs/getting-started/introduction-9","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Reduces reliance on large sets of Tailwind utility classes."},"1551":{"id":"/docs/getting-started/introduction-10","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Offers component variants through simple props such as `variant`, `color`, and `size`."},"1552":{"id":"/docs/getting-started/introduction-11","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Supports full customization using the `className` prop and Tailwind utility classes."},"1553":{"id":"/docs/getting-started/introduction-12","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Provides global and component-specific CSS variables for deeper configuration."},"1554":{"id":"/docs/getting-started/introduction-13","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Includes complete TypeScript definitions for every component."},"1555":{"id":"/docs/getting-started/introduction-14","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Supports tree shaking through per-component imports."},"1556":{"id":"/docs/getting-started/introduction-15","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#pre-requisite-knowledge","content":"HTML"},"1557":{"id":"/docs/getting-started/introduction-16","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#pre-requisite-knowledge","content":"CSS"},"1558":{"id":"/docs/getting-started/introduction-17","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#pre-requisite-knowledge","content":"JavaScript"},"1559":{"id":"/docs/getting-started/introduction-18","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#pre-requisite-knowledge","content":"React"},"1560":{"id":"/docs/getting-started