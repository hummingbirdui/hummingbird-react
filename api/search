ze/colors-8","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"`text-red-500`"},"122":{"id":"/docs/customize/colors-9","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"`bg-green-600`"},"123":{"id":"/docs/customize/colors-10","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"`border-blue-700` etc."},"124":{"id":"/docs/customize/colors-11","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"It is recommended to rely on semantic color classes. Semantic colors are mapped to design tokens and automatically adapt when themes change."},"125":{"id":"/docs/customize/colors-12","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"For example,"},"126":{"id":"/docs/customize/colors-13","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"`text-primary`"},"127":{"id":"/docs/customize/colors-14","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"`bg-subtle`"},"128":{"id":"/docs/customize/colors-15","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"`border-subtle` etc."},"129":{"id":"/docs/customize/colors-16","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"This approach prevents dependence on specific palette values (`blue-500`, `green-600`, etc.). Instead, components reference semantic roles (`primary`, `secondary`, `warning`), making the UI easier to maintain, brand, and theme."},"130":{"id":"/docs/customize/colors-17","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#overview","content":"Behind the scenes, each semantic color class points to a CSS variable. Updating or overriding that variable updates the color everywhere it is used — including inside every Hummingbird React component."},"131":{"id":"/docs/customize/colors-18","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#list-of-semantic-colors","content":"Here is the list of semantic colors that will be generated as Tailwind utilities and also available as CSS variables."},"132":{"id":"/docs/customize/colors-19","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#list-of-semantic-colors","content":"Background colors"},"133":{"id":"/docs/customize/colors-20","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#list-of-semantic-colors","content":"Text colors"},"134":{"id":"/docs/customize/colors-21","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#list-of-semantic-colors","content":"Border colors"},"135":{"id":"/docs/customize/colors-22","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#list-of-semantic-colors","content":"Theme colors (generate all color-related utilities)"},"136":{"id":"/docs/customize/colors-23","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#how-to-use","content":"Use semantic color classes like:"},"137":{"id":"/docs/customize/colors-24","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#how-to-use","content":"`bg-primary`"},"138":{"id":"/docs/customize/colors-25","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#how-to-use","content":"`text-muted`"},"139":{"id":"/docs/customize/colors-26","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#how-to-use","content":"`border-default`"},"140":{"id":"/docs/customize/colors-27","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#how-to-use","content":"These classes use the theme's color variables, so the UI stays consistent when customizing or switching themes. They can be applied to any element or passed to any component through the `className` prop."},"141":{"id":"/docs/customize/colors-28","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#customize-color","content":"Override any theme color or palette color by redefining its CSS variable inside a `@theme` block after importing Hummingbird:"},"142":{"id":"/docs/customize/colors-29","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#color-palettes","content":"Each Hummingbird theme includes its own complete color palette, carefully designed to maintain a consistent visual tone. Use these palettes to customize existing themes or create entirely new ones with confidence. Hover a swatch to see its OKLCH value, and click to copy it."},"143":{"id":"/docs/customize/colors-30","page_id":"/docs/customize/colors","tags":[],"type":"text","url":"/docs/customize/colors#default-color-palette-reference","content":"Here's a complete list of the default colors and their values for reference:"},"144":{"id":"/docs/customize/component","page_id":"/docs/customize/component","type":"page","content":"Component Customization","breadcrumbs":["Docs","Customize"],"tags":[],"url":"/docs/customize/component"},"145":{"id":"/docs/customize/component-0","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component","content":"Hummingbird React components can be customized using props, utility classes, or CSS variables to match specific design needs."},"146":{"id":"/docs/customize/component-1","page_id":"/docs/customize/component","type":"heading","tags":[],"url":"/docs/customize/component#using-props","content":"Using props"},"147":{"id":"/docs/customize/component-2","page_id":"/docs/customize/component","type":"heading","tags":[],"url":"/docs/customize/component#using-tailwind-utility-classes","content":"Using Tailwind utility classes"},"148":{"id":"/docs/customize/component-3","page_id":"/docs/customize/component","type":"heading","tags":[],"url":"/docs/customize/component#using-the-apply-directive","content":"Using the `@apply` directive"},"149":{"id":"/docs/customize/component-4","page_id":"/docs/customize/component","type":"heading","tags":[],"url":"/docs/customize/component#using-css-variables","content":"Using CSS variables"},"150":{"id":"/docs/customize/component-5","page_id":"/docs/customize/component","type":"heading","tags":[],"url":"/docs/customize/component#option-1-global-variables","content":"Option 1: Global variables"},"151":{"id":"/docs/customize/component-6","page_id":"/docs/customize/component","type":"heading","tags":[],"url":"/docs/customize/component#option-2-local-variables","content":"Option 2: Local variables"},"152":{"id":"/docs/customize/component-7","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#using-props","content":"Every Hummingbird React component ships with variants that are controlled through props. This is the first and simplest level of customization. For example, the button component can be adjusted with the `variant`, `color`, `size`, and `shape` props."},"153":{"id":"/docs/customize/component-8","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#using-props","content":"The available props for each component are listed in the API Reference section of its documentation page."},"154":{"id":"/docs/customize/component-9","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#using-tailwind-utility-classes","content":"All components accept a `className` prop. Custom classes are merged with the component classes, so any Tailwind utility can be applied on top. For example, rounded pill buttons can be created by adding the `rounded-full` class."},"155":{"id":"/docs/customize/component-10","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#using-the-apply-directive","content":"Customization can also be done in a CSS file using Tailwind CSS's `@apply` directive. Because the components render Hummingbird's CSS classes (such as `btn`), overriding the class changes every instance of the component."},"156":{"id":"/docs/customize/component-11","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#using-css-variables","content":"Hummingbird components are styled with a set of CSS variables. These variables make it easy to customize styles either globally (across the entire project) or locally (for a specific component)."},"157":{"id":"/docs/customize/component-12","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#using-css-variables","content":"For example, to update or customize the Button component, override its CSS variables:"},"158":{"id":"/docs/customize/component-13","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#option-1-global-variables","content":"Override the theme variables globally under `@theme`. This will apply the changes across all components in the project."},"159":{"id":"/docs/customize/component-14","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#option-2-local-variables","content":"Override the component variables locally under the component's class or a custom class. This will apply the changes only to that specific component."},"160":{"id":"/docs/customize/component-15","page_id":"/docs/customize/component","tags":[],"type":"text","url":"/docs/customize/component#option-2-local-variables","content":"To scope the change to only some buttons, pass a custom class through the `className` prop and target that class in CSS."},"161":{"id":"/docs/cus