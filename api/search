e `fluid` prop sets the container to full width across all breakpoints."},"1156":{"id":"/docs/layout/container-13","page_id":"/docs/layout/container","tags":[],"type":"text","url":"/docs/layout/container#breakpoint-css-variables","content":"The container uses the following CSS variables for its breakpoints. Override or extend them according to the project’s requirements."},"1157":{"id":"/docs/layout/container-14","page_id":"/docs/layout/container","tags":[],"type":"text","url":"/docs/layout/container#gutter-css-variables","content":"The container uses the following gutter CSS variables for its horizontal padding. Override or extend them according to the project’s requirements."},"1158":{"id":"/docs/layout/grid","page_id":"/docs/layout/grid","type":"page","content":"Grid","breadcrumbs":["Docs","Layout & Content"],"tags":[],"url":"/docs/layout/grid"},"1159":{"id":"/docs/layout/grid-0","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid","content":"The Grid is a twelve-column, flexbox-based layout system built from Container, Row, and Col components. It provides a familiar row and column structure for building responsive designs."},"1160":{"id":"/docs/layout/grid-1","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#basic-example","content":"Basic example"},"1161":{"id":"/docs/layout/grid-2","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#auto-layout-columns","content":"Auto-layout columns"},"1162":{"id":"/docs/layout/grid-3","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#equal-width","content":"Equal-width"},"1163":{"id":"/docs/layout/grid-4","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#variable-width-content","content":"Variable width content"},"1164":{"id":"/docs/layout/grid-5","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#responsive-props","content":"Responsive props"},"1165":{"id":"/docs/layout/grid-6","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#all-breakpoints","content":"All breakpoints"},"1166":{"id":"/docs/layout/grid-7","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#mix-and-match","content":"Mix and match"},"1167":{"id":"/docs/layout/grid-8","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#row-columns","content":"Row columns"},"1168":{"id":"/docs/layout/grid-9","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#nesting","content":"Nesting"},"1169":{"id":"/docs/layout/grid-10","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#columns","content":"Columns"},"1170":{"id":"/docs/layout/grid-11","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#vertical-alignment","content":"Vertical alignment"},"1171":{"id":"/docs/layout/grid-12","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#horizontal-alignment","content":"Horizontal alignment"},"1172":{"id":"/docs/layout/grid-13","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#order-classes","content":"Order classes"},"1173":{"id":"/docs/layout/grid-14","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#offsetting-columns","content":"Offsetting columns"},"1174":{"id":"/docs/layout/grid-15","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#gutters","content":"Gutters"},"1175":{"id":"/docs/layout/grid-16","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#horizontal-gutters","content":"Horizontal gutters"},"1176":{"id":"/docs/layout/grid-17","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#vertical-gutters","content":"Vertical gutters"},"1177":{"id":"/docs/layout/grid-18","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#horizontal--vertical-gutters","content":"Horizontal & vertical gutters"},"1178":{"id":"/docs/layout/grid-19","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#row-columns-gutters","content":"Row columns gutters"},"1179":{"id":"/docs/layout/grid-20","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#no-gutters","content":"No gutters"},"1180":{"id":"/docs/layout/grid-21","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#api-reference","content":"API Reference"},"1181":{"id":"/docs/layout/grid-22","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#row","content":"Row"},"1182":{"id":"/docs/layout/grid-23","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#col","content":"Col"},"1183":{"id":"/docs/layout/grid-24","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#css-variables","content":"CSS variables"},"1184":{"id":"/docs/layout/grid-25","page_id":"/docs/layout/grid","type":"heading","tags":[],"url":"/docs/layout/grid#styling","content":"Styling"},"1185":{"id":"/docs/layout/grid-26","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#basic-example","content":"The Grid uses the `Container`, `Row`, and `Col` components to create responsive layouts. It is built with flexbox and adapts to different screen sizes."},"1186":{"id":"/docs/layout/grid-27","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#auto-layout-columns","content":"Breakpoint props allow easy sizing of columns without setting an explicit numbered span."},"1187":{"id":"/docs/layout/grid-28","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#equal-width","content":"A `Col` without any props creates equal-width columns for every screen size."},"1188":{"id":"/docs/layout/grid-29","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#variable-width-content","content":"Setting a breakpoint prop to `\"auto\"` sizes the column based on the natural width of its content."},"1189":{"id":"/docs/layout/grid-30","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#responsive-props","content":"The `xs`, `sm`, `md`, `lg`, `xl`, and `xxl` props specify different column sizes for different screen sizes. Breakpoints are defined using minimum widths, meaning each one applies from that width upward. For example, `md={4}` applies to medium devices (tablets) and above, and renders the `md:col-4` class."},"1190":{"id":"/docs/layout/grid-31","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#all-breakpoints","content":"For grids that are the same across all breakpoints, plain `Col` and the `xs` prop are enough."},"1191":{"id":"/docs/layout/grid-32","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#mix-and-match","content":"Different breakpoint props can be combined on the same column for different screen sizes."},"1192":{"id":"/docs/layout/grid-33","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#row-columns","content":"Instead of sizing each column, the `Row` breakpoint props set the number of columns per row. The grid automatically lays out the columns evenly, and `\"auto\"` sizes them based on their content."},"1193":{"id":"/docs/layout/grid-34","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#nesting","content":"Nesting works by placing a new `Row` and set of `Col` components inside an existing `Col`. This gives more control over the layout of the content."},"1194":{"id":"/docs/layout/grid-35","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#columns","content":"Columns can be modified with options for alignment, ordering, and offsetting using the flexbox grid system."},"1195":{"id":"/docs/layout/grid-36","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#vertical-alignment","content":"The `items-start`, `items-center`, and `items-end` classes on `Row` control vertical alignment of all columns."},"1196":{"id":"/docs/layout/grid-37","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#vertical-alignment","content":"The `self-start`, `self-center`, and `self-end` classes control vertical alignment of individual columns."},"1197":{"id":"/docs/layout/grid-38","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#horizontal-alignment","content":"The `justify-*` classes on `Row` control horizontal alignment."},"1198":{"id":"/docs/layout/grid-39","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#order-classes","content":"The `order-{number}` classes change the visual order of columns."},"1199":{"id":"/docs/layout/grid-40","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#offsetting-columns","content":"The object form of a breakpoint prop moves columns to the right. For example, `md={{ span: 4, offset: 4 }}` renders the `md:col-4 md:offset-4` classes, moving the column over four columns on medium screens and larger."},"1200":{"id":"/docs/layout/grid-41","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#gutters","content":"Gutters are the spacing between columns, used to create consistent spacing and alignment in the grid system. Hummingbird supports gutter utilities up to `g-24` (6rem), applied to `Row` through the `className` prop."},"1201":{"id":"/docs/layout/grid-42","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#horizontal-gutters","content":"The `gx-{size}` classes set horizontal gutters between columns."},"1202":{"id":"/docs/layout/grid-43","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#vertical-gutters","content":"The `gy-{size}` classes set vertical gutters between rows."},"1203":{"id":"/docs/layout/grid-44","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#horizontal--vertical-gutters","content":"The `g-{size}` classes set both horizontal and vertical gutters."},"1204":{"id":"/docs/layout/grid-45","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#row-columns-gutters","content":"Gutter classes can be combined with the `Row` breakpoint props to create gutters between rows and columns."},"1205":{"id":"/docs/layout/grid-46","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#no-gutters","content":"The `g-0` class removes all gutters between rows and columns."},"1206":{"id":"/docs/layout/grid-47","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#api-reference","content":"The grid components are available from `@hummingbirdui/react` or the `@hummingbirdui/react/layout/grid` subpath. All three render a `<div>` and accept standard div attributes."},"1207":{"id":"/docs/layout/grid-48","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#css-variables","content":"The Grid uses CSS variables for easy customization. Override these variables in the CSS to change the grid's behavior."},"1208":{"id":"/docs/layout/grid-49","page_id":"/docs/layout/grid","tags":[],"type":"text","url":"/docs/layout/grid#styling","content":"Hummingbird React grid components are styled entirely through Hummingbird's grid classes and CSS variables. See the Hummingbird Grid documentation for the full class reference."},"1209":{"id":"/docs/layout/text","page_id":"/docs/layout/text","type":"page","content":"Text","breadcrumbs":["Docs","Layout & Content"],"tags":[],"url":"/docs/layout/text"},"1210":{"id":"/docs/layout/text-0","page_id":"/docs/layout/text","tags":[],"type":"text","url":"/docs/layout/text","content":"Text is a polymorphic typography component for rendering any text element with consistent size, weight, and overflow handling."},"1211":{"id":"/docs/layout/text-1","page_id":"/docs/layout/text","type":"heading","tags":[],"url":"/docs/layout/text#default","content":"Default"},"1212":{"id":"/docs/layout/text-2","page_id":"/docs/layout/text","type":"heading","tags":[],"url":"/docs/layout/text#headings","content":"Headings"},"1213":{"id":"/docs/layout/text-3","page_id":"/docs/layout/text","type":"heading","tags":[],"url":"/docs/layout/text#elements","content":"Elements"},"1214":{"id":"/docs/layout/text-4","page_id":"/docs/layout/text","type":"heading","tags":[],"url":"/docs/layout/text#sizes","content":"Sizes"},"1215":{"id":"/docs/layout/text-5","page_id":"/docs/layout/text","type":"heading","tags":[],"url":"/docs/layout/text#font-weight","content":"Font weight"},"1216":{"id":"/docs/layout/text-6","page_id":"/docs/layout/text","type":"heading","tags":[],"url":"/docs/layout/text#truncate","content":"Truncate"},"1217":{"id":"/docs/layout/text-7","page_id":"/docs/layout/text","type":"heading","tags":[],"url":"/docs/layout/text#line-clamp","content":"Line clamp"},"1218":{"id":"/docs/layout/text-8","page_id":"/docs/layout/text","type":"heading","tags":[],"url":"/docs/layout/text#api-reference","content":"API Reference"},"1219":{"id":"/docs/layout/text-9","page_id":"/docs/layout/text","tags":[],"type":"text","url":"/docs/layout/text#default","content":"Text renders a `p` element by default."},"1220":{"id":"/docs/layout/text-10","page_id":"/docs/layout/text","tags":[],"type":"text","url":"/docs/layout/text#headings","content":"Text can render any heading element from `h1` to `h6`."},"1221":{"id":"/docs/layout/text-11","page_id":"/docs/layout/text","tags":[],"type":"text","url":"/docs/layout/text#elements","content":"Other text elements can be rendered by passing the `as` prop."},"1222":{"id":"/docs/layout/text-12","page_id":"/docs/layout/text","tags":[],"type":"text","url":"/docs/layout/text#sizes","content":"The `size` prop sets the font size, from `xs` up to `9xl`."},"1223":{"id":"/docs/layout/text-13","page_id":"/docs/layout/text","tags":[],"type":"text","url":"/docs/layout/text#font-weight","content":"The `fontWeight` prop sets the font weight, from `thin` up to `black`."},"1224":{"id":"/docs/layout/text-14","page_id":"/docs/layout/text","tags":[],"type":"text","url":"/docs/layout/text#truncate","content":"Setting `truncate` cuts off overflowing text on a single line with an ellipsis."},"1225":{"id":"/docs/layout/text-15","page_id":"/docs/layout/text","tags":[],"type":"text","url":"/docs/layout/text#line-clamp","content":"The `lineClamp` prop limits the text to the given number of lines and truncates the overflow with an ellipsis."},"1226":{"id":"/docs/getting-started/installation","page_id":"/docs/getting-started/installation","type":"page","content":"Installation","breadcrumbs":["Docs","Getting Started"],"tags":[],"url":"/docs/getting-started/installation"},"1227":{"id":"/docs/getting-started/installation-0","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"Install Hummingbird React and set it up in your project."},"1228":{"id":"/docs/getting-started/installation-1","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#installation","content":"Installation"},"1229":{"id":"/docs/getting-started/installation-2","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#1-install-tailwind-css","content":"1\\. Install Tailwind CSS"},"1230":{"id":"/docs/getting-started/installation-3","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#2-install-hummingbird-react","content":"2\\. Install Hummingbird React"},"1231":{"id":"/docs/getting-started/installation-4","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#3-import-css","content":"3\\. Import CSS"},"1232":{"id":"/docs/getting-started/installation-5","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#4-use-components","content":"4\\. Use components"},"1233":{"id":"/docs/getting-started/installation-6","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#typescript-support","content":"TypeScript support"},"1234":{"id":"/docs/getting-started/installation-7","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#customization","content":"Customization"},"1235":{"id":"/docs/getting-started/installation-8","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#installation","content":"Using a framework? The framework guides cover Next.js, Vite, Astro, React Router, and Gatsby step by step, including dark mode setup."},"1236":{"id":"/docs/getting-started/installation-9","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#1-install-tailwind-css","content":"Ensure the project is set up with Tailwind CSS. If Tailwind CSS hasn't been set up yet, follow the official installation guide."},"1237":{"id":"/docs/getting-started/installation-10","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#2-install-hummingbird-react","content":"Install Hummingbird React via a preferred package manager."},"1238":{"id":"/docs/getting-started/installation-11","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#3-import-css","content":"Import Hummingbird styles in the main CSS file (e.g., `globals.css`)."},"1239":{"id":"/docs/getting-started/installation-12","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#4-use-components","content":"Import any component and use it in the application."},"1240":{"id":"/docs/getting-started/installation-13","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#typescript-support","content":"Hummingbird React is written in TypeScript and includes type definitions for all components. Component props are fully typed and available on each component's namespace, so no additional `@types` packages are needed."},"1241":{"id":"/docs/getting-started/installation-14","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#customization","content":"All components accept a `className` prop. Custom classes are merged with the component classes, so Tailwind utility classes can be used to adjust any component."},"1242":{"id":"/docs/getting-started/installation-15","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#customization","content":"For theme-level changes such as colors and spacing, Hummingbird provides global and component-specific CSS variables. See the Customize section for details."},"1243":{"id":"/docs/getting-started/introduction","page_id":"/docs/getting-started/introduction","type":"page","content":"Introduction","breadcrumbs":["Docs","Getting Started"],"tags":[],"url":"/docs/getting-started/introduction"},"1244":{"id":"/docs/getting-started/introduction-0","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction","content":"Welcome to the Hummingbird React documentation. It is an open-source React component library built on Hummingbird CSS and Radix UI primitives."},"1245":{"id":"/docs/getting-started/introduction-1","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#what-is-hummingbird-react","content":"What is Hummingbird React?"},"1246":{"id":"/docs/getting-started/introduction-2","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Why Hummingbird React?"},"1247":{"id":"/docs/getting-started/introduction-3","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#pre-requisite-knowledge","content":"Pre-requisite knowledge"},"1248":{"id":"/docs/getting-started/introduction-4","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#join-our-community","content":"Join our community"},"1249":{"id":"/docs/getting-started/introduction-5","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#what-is-hummingbird-react","content":"Hummingbird React is the official React component library for the Hummingbird design system. It provides a large set of accessible, fully styled React components such as buttons, forms, dialogs, and dropdowns, along with patterns suitable for dashboards, SaaS applications, and e-commerce systems."},"1250":{"id":"/docs/getting-started/introduction-6","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#what-is-hummingbird-react","content":"The library follows one core principle: **Hummingbird CSS owns the visuals, and Radix UI owns the behavior**. Every component is styled with Hummingbird's component classes on top of Tailwind CSS, while interactive components use Radix UI primitives for keyboard navigation, focus management, and accessibility. Hummingbird React is the bridge between the two."},"1251":{"id":"/docs/getting-started/introduction-7","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Provides ready-to-use React components with a consistent, typed API."},"1252":{"id":"/docs/getting-started/introduction-8","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Ships accessible behavior out of the box through Radix UI primitives."},"1253":{"id":"/docs/getting-started/introduction-9","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Reduces reliance on large sets of Tailwind utility classes."},"1254":{"id":"/docs/getting-started/introduction-10","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Offers component variants through simple props such as `variant`, `color`, and `size`."},"1255":{"id":"/docs/getting-started/introduction-11","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Supports full customization using the `className` prop and Tailwind utility classes."},"1256":{"id":"/docs/getting-started/introduction-12","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Provides global and component-specific CSS variables for deeper configuration."},"1257":{"id":"/docs/getting-started/introduction-13","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Includes complete TypeScript definitions for every component."},"1258":{"id":"/docs/getting-started/introduction-14","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#why-hummingbird-react","content":"Supports tree shaking through per-component imports."},"1259":{"id":"/