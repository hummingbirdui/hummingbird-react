{
  "name": "hummingbird-react",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version-packages": "changeset version && node .github/scripts/sync-template-versions.mjs && pnpm install --lockfile-only",
    "release": "turbo run build lint check-types test --filter=@hummingbirdui/react --filter=create-hummingbird-react-app && bash .github/scripts/publish-packages.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "prettier": "^3.9.4",
    "turbo": "^2.10.10",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@hummingbirdui/hummingbird": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.1",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tsup": "^9.0.0"
  }
}
