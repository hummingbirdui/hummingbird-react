{
  "name": "docs",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "predeploy": "next build",
    "deploy": "gh-pages -d out -b gh-pages --dotfiles",
    "predev": "node scripts/fetch-themes.mjs",
    "prebuild": "node scripts/fetch-themes.mjs",
    "predeploy:internal": "next build",
    "deploy:internal": "echo staging-react.hbui.dev > ./out/CNAME && gh-pages -d out --dotfiles -r https://github.com/hummingbirdui/staging-react.git"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@hummingbirdui/react": "workspace:^",
    "@types/react-frame-component": "^4.1.6",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "fumadocs-core": "^16.10.4",
    "fumadocs-mdx": "^15.0.12",
    "lucide-react": "^1.21.0",
    "next": "16.3.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-frame-component": "^5.3.2",
    "react-hook-form": "^7.66.1",
    "rehype-autolink-headings": "^7.1.0",
    "swiper": "^14.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "gh-pages": "^6.3.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4"
  ]
}
